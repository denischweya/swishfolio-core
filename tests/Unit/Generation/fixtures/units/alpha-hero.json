  "pageTypes": ["home"],
  "styleVariations": [],
  "capacity": { "headline": 40 },
  "requiresMedia": 0,
  "ksesStable": true,
  "slots": {
    "label": { "type": "text", "maxLength": 30, "inComment": true, "default": "Hero" },
