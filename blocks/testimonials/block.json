{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "swishfolio-core/testimonials",
	"version": "2.0.1",
	"title": "Testimonials",
	"category": "swishfolio",
	"description": "Grid of testimonial cards. Add testimonials inline as child blocks.",
	"keywords": [ "testimonials", "reviews", "quotes", "feedback" ],
	"textdomain": "swishfolio-core",
	"attributes": {
		"columns": {
			"type": "number",
			"default": 3
		},
		"cardBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"cardBorderColor": {
			"type": "string",
			"default": ""
		},
		"cardBorderWidth": {
			"type": "number",
			"default": 0
		},
		"cardBorderRadius": {
			"type": "number",
			"default": 18
		},
		"cardShadow": {
			"type": "string",
			"default": "none"
		},
		"textColor": {
			"type": "string",
			"default": ""
		},
		"roleColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./build/index.css",
	"style": "file:./build/style-index.css"
}
