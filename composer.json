{
	"name": "swishfolio/swishfolio-core",
	"description": "Core functionality for Swishfolio theme - custom blocks, post types, and taxonomies",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"SwishfolioCore\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SwishfolioCore\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"test": "phpunit --testsuite unit"
	},
	"config": {
		"optimize-autoloader": true
	}
}
